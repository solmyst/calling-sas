# Typed simulation needs no provider credentials; voice uses the selected services.
APP_ENV=local
HOST=127.0.0.1
PORT=8787
PUBLIC_ORIGIN=http://127.0.0.1:8787
# DATABASE_PATH=/absolute/path/to/relay.sqlite
# Optional locally; required for hosted mode (16+ characters).
DEMO_PASSWORD=
# Required for hosted mode (32+ random characters).
SESSION_SECRET=
# Real calls are unavailable regardless of environment flags.
# Browser voice requires dedicated provider credentials. Phone calls remain unavailable.
ASSEMBLYAI_API_KEY=
BIFROST_URL=https://bifrost.parkplus.io/v1
BIFROST_VK=
BIFROST_MODELS=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_MODEL=eleven_flash_v2_5

# Select Gnani only after adding a dedicated key. No automatic provider fallback.
SPEECH_PROVIDER=gnani
GNANI_API_KEY=
# Documented defaults; choose model/voice after a listening test in your account.
GNANI_STT_MODEL=prisma-v3.0
GNANI_TTS_MODEL=timbre-v3.0
GNANI_VOICE=Shivani
GNANI_SILENCE_MS=600
GNANI_SPEED=1.0
# Optional Timbre v3 delivery cues: pauses; excited only for an upbeat agent.
GNANI_AUDIO_TAGS=false
