# Typed simulation needs no provider credentials; voice uses the selected services.
APP_ENV=local
HOST=127.0.0.1
PORT=8787
PUBLIC_ORIGIN=http://127.0.0.1:8787
# DATABASE_PATH=/absolute/path/to/relay.sqlite
# Main account: sign in with ADMIN_EMAIL and DEMO_PASSWORD (16+ characters in hosted mode).
# Setting DEMO_PASSWORD also enables trial sign-up. Leave empty locally for no sign-in.
ADMIN_EMAIL=admin
DEMO_PASSWORD=
# Required for hosted mode (32+ random characters).
SESSION_SECRET=
# Real calls are unavailable regardless of environment flags.
# Browser voice requires dedicated provider credentials. Phone calls remain unavailable.
BIFROST_URL=https://bifrost.parkplus.io/v1
BIFROST_VK=
BIFROST_MODELS=
BIFROST_REASONING_EFFORT=minimal
LLM_PROVIDER=bifrost
GROQ_API_KEY=
GROQ_URL=https://api.groq.com/openai/v1
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_REASONING_EFFORT=none
LLM_FALLBACK_ENABLED=true
GROQ_FALLBACK_TIMEOUT_SECONDS=3.0
GROQ_CIRCUIT_SECONDS=30

# Gnani speech. Browser voice stays disabled until a dedicated key is set.
GNANI_API_KEY=
# Documented defaults; choose model/voice after a listening test in your account.
GNANI_STT_MODEL=prisma-v3.0
GNANI_TTS_MODEL=timbre-v3.0
GNANI_VOICE=Shivani
GNANI_SILENCE_MS=500
GNANI_SPEED=1.0
# Optional Timbre v3 delivery cues: pauses; excited only for an upbeat agent.
GNANI_AUDIO_TAGS=false
